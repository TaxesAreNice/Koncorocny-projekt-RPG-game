<Window x:Name="Window" x:Class="Koncoročný_projekt__RPG_game.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Koncoročný_projekt__RPG_game"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="1500" KeyDown="Window_KeyDown">
    <Grid>


        <Label x:Name="TheInteractions" Content="" HorizontalAlignment="Center" Margin="0,620,0,0" VerticalAlignment="Top" Height="114" Width="1500" FontSize="30" Background="Gray"/>


        <Grid x:Name="Map_UI" Margin="0,0,0,98" Background="Black"/>


        <Grid x:Name="Inventory" Background="#FF444242" MouseDown="Inventory_MouseDown" Visibility="Collapsed">
            <Grid x:Name="Item_Stuff" Margin="0,502,1030,0" Background="Gray">

                <Label Content="Item Name:" HorizontalAlignment="Left" VerticalAlignment="Top" Background="DarkGray" Height="52" Margin="0,32,0,0" Width="235" FontSize="30"/>
                <Label Content="Item Description:" HorizontalAlignment="Left" VerticalAlignment="Top" Background="DarkGray" Height="52" Width="235" FontSize="30" Margin="0,116,0,0"/>
                <Label x:Name="Item_Description" Content="           -" HorizontalAlignment="Left" VerticalAlignment="Top" Background="DarkGray" Height="52" Margin="245,116,0,0" Width="200" FontSize="30"/>
                <Label x:Name="Item_Name" Content="           -" HorizontalAlignment="Left" VerticalAlignment="Top" Background="DarkGray" Height="52" Margin="245,32,0,0" Width="200" FontSize="30"/>
            </Grid>
            <Grid x:Name="Item_Stuff_Copy" Margin="475,502,578,0" Background="Gray">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="29*"/>
                    <ColumnDefinition Width="437*"/>
                </Grid.ColumnDefinitions>

                <Label Content="Player HP:" HorizontalAlignment="Left" VerticalAlignment="Top" Background="DarkGray" Height="52" Margin="10,10,0,0" Width="225" FontSize="30" Grid.ColumnSpan="2"/>
                <Label Content="Player Attack:" HorizontalAlignment="Left" VerticalAlignment="Top" Background="DarkGray" Height="52" Margin="10,144,0,0" Width="225" FontSize="30" Grid.ColumnSpan="2"/>
                <Label Content="Player Defence:" HorizontalAlignment="Left" VerticalAlignment="Top" Background="DarkGray" Height="52" Width="225" FontSize="30" Margin="10,79,0,0" Grid.ColumnSpan="2"/>
                <Label x:Name="PlayerAttack_UI" Content="         -" HorizontalAlignment="Left" VerticalAlignment="Top" Background="DarkGray" Height="52" Margin="216,144,0,0" Width="171" FontSize="30" Grid.Column="1"/>
                <Label x:Name="PlayerDefence_UI" Content="         -" HorizontalAlignment="Left" VerticalAlignment="Top" Background="DarkGray" Height="52" Margin="216,79,0,0" Width="171" FontSize="30" Grid.Column="1"/>
                <Label x:Name="PlayerHP_UI" Content="         -" HorizontalAlignment="Left" VerticalAlignment="Top" Background="DarkGray" Height="52" Margin="216,10,0,0" Width="171" FontSize="30" Grid.Column="1"/>
            </Grid>
        </Grid>

        <Grid x:Name="Fighting_UI" Background="#FF444242" Visibility="Collapsed">
            <Grid x:Name="Player_Grid" Margin="38,123,952,162" Background="DarkGray">
                <Grid.RowDefinitions>
                    <RowDefinition Height="225*"/>
                    <RowDefinition Height="224*"/>
                </Grid.RowDefinitions>
                <ProgressBar x:Name="PlayerHp_Bar" HorizontalAlignment="Center" Height="50" Margin="0,10,0,0" VerticalAlignment="Top" Width="446" Background="Gray" Value="50" Foreground="#FFFF1212"/>
                <Label x:Name="PlayerHp_Label" Content="50hp" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="30" Height="53" Margin="0,10,0,0" Foreground="White"/>
                <Rectangle x:Name="Player_Image" HorizontalAlignment="Center" Height="250" Margin="0,68,0,0" Stroke="Black" VerticalAlignment="Top" Width="250" Fill="Gray" Grid.RowSpan="2"/>
                <Label Content="Defence:" HorizontalAlignment="Left" Margin="103,140,0,0" VerticalAlignment="Top" Background="Gray" Height="47" Width="70" FontSize="15" Grid.Row="1"/>
                <Label x:Name="Player_Attack" Content="   -" HorizontalAlignment="Left" Margin="364,128,0,0" VerticalAlignment="Top" Background="Gray" Height="57" Width="70" FontSize="30" Grid.Row="1"/>
                <Label x:Name="Player_Defence" Content="   -" HorizontalAlignment="Left" Margin="185,128,0,0" VerticalAlignment="Top" Background="Gray" Height="57" Width="70" FontSize="30" Grid.Row="1"/>
                <Label Content="Attack:" HorizontalAlignment="Left" Margin="275,138,0,0" VerticalAlignment="Top" Background="Gray" Height="47" Width="70" FontSize="15" Grid.Row="1"/>
            </Grid>
            <Grid x:Name="Enemy_Grid" Margin="852,75,38,75" Background="Gray" MouseDown="Enemy_Grid_MouseDown" />
            <Button x:Name="Attack" Content="Attack" HorizontalAlignment="Left" Margin="642,0,0,0" VerticalAlignment="Center" Height="106" Width="108" FontSize="20" Click="Attack_Click"/>
            <Grid x:Name="EventTeller" Margin="559,0,660,530" Background="#FF797878">
                <ListBox x:Name="Eventer" d:ItemsSource="{d:SampleData ItemCount=5}" Background="Gray" FontSize="20"/>
            </Grid>
        </Grid>



        <Grid x:Name="Studio" Margin="1292,0,0,0" Background="#FF7D7D7D" Visibility="Collapsed">
            <Label x:Name="CurrentBlockType" Content="Current block:" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Background="#FFB2B2B2" Height="48" Width="172" FontSize="18"/>



            <Grid x:Name="Buttons_Grid_Studio" Margin="0,69,0,381" Background="#FF615F5F" Visibility="Visible">
                <Button x:Name="Left_Walls_Studio" Content="Left Walls" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" Height="52" Width="80" FontSize="18" Click="Left_Walls_Studio_Click_1"/>
                <Button x:Name="Right_Walls_Studio" Content="Right Walls" HorizontalAlignment="Left" Margin="85,11,0,0" VerticalAlignment="Top" Height="52" Width="97" FontSize="15" Click="Right_Walls_Studio_Click"/>
                <Button x:Name="Top_Walls_Studio" Content="Top Walls" HorizontalAlignment="Left" Margin="0,67,0,0" VerticalAlignment="Top" Height="52" Width="80" FontSize="18" Click="Top_Walls_Studio_Click"/>
                <Button x:Name="Buttom_Walls_Studio" Content="Buttom Walls" HorizontalAlignment="Left" Margin="85,68,0,0" VerticalAlignment="Top" Height="52" Width="97" FontSize="15" Click="Buttom_Walls_Studio_Click"/>
                <Button x:Name="Flores_Studio" Content="Floors" HorizontalAlignment="Left" Margin="0,125,0,0" VerticalAlignment="Top" Height="52" Width="80" FontSize="18" Click="Flores_Studio_Click"/>
                <Button x:Name="Items_Studio" Content="Items" HorizontalAlignment="Left" Margin="85,125,0,0" VerticalAlignment="Top" Height="52" Width="97" FontSize="18" Click="Items_Studio_Click"/>
                <Button x:Name="NPCs_Studio" Content="NPCs" HorizontalAlignment="Left" Margin="0,182,0,0" VerticalAlignment="Top" Height="45" Width="80" FontSize="18" Click="NPCs_Studio_Click"/>
                <Button x:Name="Doors_Studio" Content="Doors" HorizontalAlignment="Left" Margin="85,182,0,0" VerticalAlignment="Top" Height="45" Width="97" FontSize="18" Click="Doors_Studio_Click"/>
                <Button x:Name="Chest_Studio" Content="Chests" HorizontalAlignment="Left" Margin="0,232,0,0" VerticalAlignment="Top" Height="45" Width="80" FontSize="18" Click="Chest_Studio_Click"/>
                <Button x:Name="RoomDoor_Studio" Content="RoomDoor" HorizontalAlignment="Left" Margin="85,232,0,0" VerticalAlignment="Top" Height="45" Width="97" FontSize="18" Click="RoomDoor_Studio_Click"/>
            </Grid>
            <Grid x:Name="AddThingy_Studio">
                <Button x:Name="Back_Studio" Content="Back" HorizontalAlignment="Left" Margin="131,663,0,0" VerticalAlignment="Top" Height="36" Width="54" FontSize="20" Click="Back_Studio_Click" Visibility="Hidden"/>
                <Label x:Name="Current_State_Studio" Content="Current State: Menu" HorizontalAlignment="Center" Margin="0,594,0,0" VerticalAlignment="Top" Height="40" Width="188" Background="#FFB7B4B4" FontSize="18"/>
                <Button x:Name="Slot_1_Studio" Content="" HorizontalAlignment="Left" Margin="10,354,0,0" VerticalAlignment="Top" Height="47" Width="59" Click="Slot_1_Studio_Click"/>
                <Button x:Name="Slot_2_Studio" Content="" HorizontalAlignment="Left" Margin="136,354,0,0" VerticalAlignment="Top" Height="49" Width="49" Click="Slot_2_Studio_Click"/>
                <Button x:Name="Slot_3_Studio" Content="" HorizontalAlignment="Left" Margin="10,408,0,0" VerticalAlignment="Top" Height="47" Width="77" Click="Slot_3_Studio_Click"/>
                <Button x:Name="Slot_4_Studio" Content="" HorizontalAlignment="Left" Margin="109,408,0,0" VerticalAlignment="Top" Height="47" Width="76" Click="Slot_4_Studio_Click"/>
                <TextBox x:Name="Texter_Studio" HorizontalAlignment="Center" Margin="0,484,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="186" Height="44"/>
                <Button Content="Add" HorizontalAlignment="Left" Margin="48,533,0,0" VerticalAlignment="Top" Height="46" Width="96" FontSize="30" Click="Button_Click"/>


            </Grid>


        </Grid>
        <Label x:Name="Text_Of_All_Texts" Content="Fafafela" HorizontalAlignment="Left" Margin="0,648,0,0" VerticalAlignment="Top" Height="72" Width="1152" FontSize="50" Background="DarkGray" Visibility="Collapsed"/>

        <Grid x:Name="AdmitGrid" Margin="1292,0,0,0" Background="#FF423252" Visibility="Collapsed">
            <Button x:Name="Add_Item" Content="Add Item" HorizontalAlignment="Center" Margin="0,521,0,0" VerticalAlignment="Top" Height="74" Width="144" FontSize="30" Click="Add_Item_Click"/>
            <TextBox x:Name="item_name" HorizontalAlignment="Center" Margin="0,600,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="158" Height="56" TextChanged="item_name_TextChanged"/>
            <Button x:Name="start" Content="Load Map" HorizontalAlignment="Left" Margin="40,256,0,0" VerticalAlignment="Top" Height="150" Width="104" Click="start_Click" FontSize="20"/>
            <Button x:Name="StudioAct" Content="Button" HorizontalAlignment="Center" Margin="0,678,0,0" VerticalAlignment="Top" Height="46" Width="72" Click="StudioAct_Click"/>
            <TextBox x:Name="MapSize" HorizontalAlignment="Left" Margin="25,411,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="181" Height="84" Text="h"/>
            <Button x:Name="StartFight_but" Content="Fight" HorizontalAlignment="Left" Margin="51,52,0,0" VerticalAlignment="Top" Height="79" Width="89" Click="StartFight_but_Click" FontSize="20"/>
            <TextBox x:Name="Enemy_Num" HorizontalAlignment="Left" Margin="39,151,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="144" Height="59" TextChanged="Enemy_Num_TextChanged"/>
        </Grid>
        <Grid x:Name="ChestGrid" Background="DarkGray" Margin="208,55,280,266" Visibility="Collapsed" MouseDown="ChestGrid_MouseDown">
            <Button x:Name="Exit_Chest" Content="X" HorizontalAlignment="Left" Margin="951,10,0,0" VerticalAlignment="Top" Height="38" Width="33" Background="Red" FontSize="30" Foreground="White" Click="Exit_Chest_Click"/>
            <Grid x:Name="CurrentPlayerInventory_Chest" Margin="10,372,10,10" Background="Gray" Visibility="Collapsed"/>
            <Grid x:Name="ChestInventory_Chest" Margin="10,64,10,63" Background="Gray">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="455*"/>
                    <ColumnDefinition Width="41*"/>
                </Grid.ColumnDefinitions>
            </Grid>

        </Grid>
    </Grid>
</Window>
